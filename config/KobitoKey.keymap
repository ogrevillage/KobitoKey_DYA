#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "layout_shift.dtsi"

/ {
    behaviors {
        // Keep the original key_press behavior for ZMK core components

        original_key_press: original_key_press {
            compatible = "zmk,behavior-key-press";
            #binding-cells = <1>;
            label = "KEY_PRESS";
        };

        // Override the existing &kp behavior to use our custom implementation

        kp: key_press {
            compatible = "zmk,behavior-layout-shift-key-press";
            #binding-cells = <1>;
            label = "LAYOUT_SHIFT_KEY_PRESS";
        };
    };
};

/ {
    macros {
        paren_pair: paren_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp LS(NUMBER_8) &kp LS(NUMBER_9) &kp LEFT_ARROW>;
        };

        bracket_pair: bracket_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp RIGHT_BRACKET &kp NUHS &kp LEFT_ARROW>;
        };

        long_vowel: long_vowel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS>;
        };

        eisu_base: eisu_base {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2>, <&to 0>;
        };

        kana_base: kana_base {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG1>, <&to 0>;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_eisu {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&eisu_base>;
            layers = <0 1 5>;
        };

        combo_kana {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kana_base>;
            layers = <0 1 5>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
            layers = <0>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&kp TAB>;
            layers = <0>;
        };

        combo_shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <20 21>;
            layers = <0>;
        };

        combo_long_vowel {
            timeout-ms = <50>;
            key-positions = <8 9>;
            bindings = <&long_vowel>;
            layers = <0>;
        };

        combo_paren_pair {
            timeout-ms = <50>;
            key-positions = <18 19>;
            bindings = <&paren_pair>;
            layers = <0 1 5>;
        };

        combo_bracket_pair {
            timeout-ms = <50>;
            key-positions = <28 29>;
            bindings = <&bracket_pair>;
            layers = <0 1 5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "L0 BASE";
            bindings = <
&kp Q             &kp W     &kp E  &kp R     &kp T                            &kp Y            &kp U            &kp I      &kp O     &lt 4 P
&kp A             &kp S     &kp D  &kp F     &kp G                            &kp H            &kp J            &kp K      &kp L     &kp SEMI
&kp Z             &kp X     &kp C  &kp V     &kp B                            &kp N            &kp M            &kp COMMA  &kp DOT   &kp APOS
&mt LCTRL ESCAPE  &kp LWIN         &kp LALT  &lt 2 DEL  &kp SPACE  &kp ENTER  &lt 5 BACKSPACE  &kp RIGHT_SHIFT             &kp INT1  &mt LALT SLASH
            >;
        };

        NUM {
            label = "L1 NUMBER";
            bindings = <
&kp LEFT_BRACKET  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans                         &kp KP_MINUS     &trans          &kp UP_ARROW    &trans           &kp LEFT_BRACKET
&kp INT3          &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp LS(MINUS)                  &kp KP_PLUS      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&kp NUMBER_0      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD                     &kp KP_MULTIPLY  &kp KP_SLASH    &trans          &trans           &trans
&trans            &trans                      &trans        &trans         &trans  &trans  &trans           &trans                          &trans           &trans
            >;
        };

        FUNC {
            label = "L2 FUNCTION";
            bindings = <
&trans  &trans                  &kp LG(Z)           &trans                   &trans                  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5
&trans  &kp LG(LS(LEFT_ARROW))  &kp LG(UP_ARROW)    &kp LS(LG(RIGHT_ARROW))  &trans                  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10
&trans  &kp LG(LEFT_ARROW)      &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)      &trans                  &kp F11  &kp F12  &trans  &trans  &trans
&trans  &trans                                      &trans                   &trans  &trans  &trans  &trans   &trans           &trans  &trans
            >;
        };

        MOUSE {
            label = "L3 MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                 &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans                 &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans                 &trans  &trans    &trans    &trans    &trans
&trans  &trans          &trans  &trans  &to 0  &trans  &trans  &trans              &to 0     &trans
            >;
        };

        BT {
            label = "L4 BT";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &bt BT_PRV    &bt BT_NXT    &trans                        &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans                        &trans  &trans  &trans  &trans  &trans
&trans        &trans                      &trans        &trans        &trans  &trans  &trans  &trans          &trans  &trans
            >;
        };

        NUM2 {
            label = "L5 NUMBER2";
            bindings = <
&kp N1            &kp N2          &kp N3          &kp N4           &kp N5                     &kp N6         &kp N7  &kp N8  &kp N9  &kp KP_SLASH
&trans            &trans          &kp UP_ARROW    &kp INT3         &kp COMMA                  &kp LS(MINUS)  &kp N4  &kp N5  &kp N6  &kp KP_MULTIPLY
&kp LEFT_BRACKET  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp APOS                   &kp PERIOD     &kp N1  &kp N2  &kp N3  &kp KP_MINUS
&kp LEFT_SHIFT    &trans                          &kp LEFT_SHIFT   &trans     &trans  &trans  &trans         &trans          &kp N0  &kp KP_PLUS
            >;
        };
    };
};
