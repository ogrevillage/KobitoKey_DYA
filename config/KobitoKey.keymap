#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/modifiers.h>
#include "layout_shift.dtsi"

// Keymap behavior timings follow LisM; the KobitoKey auto-mouse timer stays 5000 ms.
&mt { tapping-term-ms = <300>; flavor = "balanced"; };
&lt { quick-tap-ms = <300>; };

/ {
    behaviors {
        // LisM behavior: Left Alt+A = Alt+Tab, Left Alt+Shift+A = reverse.
        // Ctrl / Win / right Alt override it and preserve A.
        alt_a_tab: alt_a_tab {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp A>, <&kp TAB>;
            mods = <MOD_LALT>;
            keep-mods = <MOD_LALT>;
        };
        alt_only_a: alt_only_a {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&alt_a_tab>, <&kp A>;
            mods = <(MOD_LCTL | MOD_RCTL | MOD_LGUI | MOD_RGUI | MOD_RALT)>;
            keep-mods = <(MOD_LCTL | MOD_RCTL | MOD_LGUI | MOD_RGUI | MOD_RALT)>;
        };

        // Keep the original key_press behavior for ZMK core components

        original_key_press: original_key_press {
            compatible = "zmk,behavior-key-press";
            #binding-cells = <1>;
            label = "KEY_PRESS";
        };

        // Override the existing &kp behavior to use our custom implementation

        kp: key_press {
            compatible = "zmk,behavior-layout-shift-key-press";
            #binding-cells = <1>;
            label = "LAYOUT_SHIFT_KEY_PRESS";
        };
    };
};

/ {
    macros {
        paren_pair: paren_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp LS(NUMBER_8) &kp LS(NUMBER_9) &kp LEFT_ARROW>;
        };

        bracket_pair: bracket_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp RIGHT_BRACKET &kp NUHS &kp LEFT_ARROW>;
        };

        long_vowel: long_vowel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS>;
        };

        eisu_base: eisu_base {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2>;
        };

        kana_base: kana_base {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG1>;
        };

        // LisM IME combos: exit the mouse layer after switching the input method.
        ime_eisu_base: ime_eisu_base {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>; tap-ms = <30>;
            bindings = <&kp LANG2 &to 0>;
        };
        ime_kana_base: ime_kana_base {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>; tap-ms = <30>;
            bindings = <&kp LANG1 &to 0>;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";
        // Copy LisM combo positions. Physical positions 0..29 match KobitoKey.
        combo_eisu { timeout-ms = <50>; key-positions = <11 13>; bindings = <&kp LANG2>; layers = <0 1 5>; };
        combo_kana { timeout-ms = <50>; key-positions = <16 18>; bindings = <&kp LANG1>; layers = <0 1 5>; };
        combo_eisu_mouse { timeout-ms = <50>; key-positions = <11 13>; bindings = <&ime_eisu_base>; layers = <3>; };
        combo_kana_mouse { timeout-ms = <50>; key-positions = <16 18>; bindings = <&ime_kana_base>; layers = <3>; };
        combo_esc { timeout-ms = <50>; key-positions = <0 1>; bindings = <&kp ESC>; layers = <0>; };
        combo_tab { timeout-ms = <50>; key-positions = <10 11>; bindings = <&kp TAB>; layers = <0>; };
        combo_long_vowel { timeout-ms = <50>; key-positions = <8 9>; bindings = <&kp MINUS>; layers = <0 1 5>; };
        combo_at { timeout-ms = <50>; key-positions = <13 16>; bindings = <&kp LEFT_BRACKET>; layers = <0>; };
        combo_paren_pair { timeout-ms = <50>; key-positions = <18 19>; bindings = <&paren_pair>; layers = <0 1 5>; };
        combo_bracket_pair { timeout-ms = <50>; key-positions = <28 29>; bindings = <&bracket_pair>; layers = <0 1 5>; };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "L0 BASE / LisM";
            bindings = <
                &kp Q            &kp W                 &kp E               &kp R                &kp T                 &kp Y                &kp U           &kp I            &kp O                &lt 4 P
                &alt_only_a      &kp S                 &kp D               &kp F                &kp G                 &kp H                &kp J           &kp K            &kp L                &kp SEMI
                &mt LSHIFT Z     &kp X                 &kp C               &kp V                &kp B                 &kp N                &kp M           &kp COMMA        &kp DOT              &mt RSHIFT APOS
                &mt LCTRL ESCAPE &kp LWIN              &kp LALT            &lt 5 DEL            &kp SPACE             &kp ENTER            &lt 2 BACKSPACE &kp RIGHT_SHIFT  &mt RGUI INT1        &mt RCTRL SLASH
            >;
        };

        NUM {
            label = "L1 NUMBER / LisM";
            bindings = <
                &kp LEFT_BRACKET &kp NUMBER_7          &kp NUMBER_8        &kp NUMBER_9        &trans                &kp KP_MINUS         &trans          &kp UP_ARROW     &trans                &kp LEFT_BRACKET
                &kp INT3         &kp NUMBER_4          &kp NUMBER_5        &kp NUMBER_6        &kp LS(MINUS)         &kp KP_PLUS          &kp LEFT_ARROW  &kp DOWN_ARROW   &kp RIGHT_ARROW       &trans
                &kp NUMBER_0     &kp NUMBER_1          &kp NUMBER_2        &kp NUMBER_3        &kp PERIOD            &kp KP_MULTIPLY      &kp KP_SLASH    &trans          &trans                &trans
                &trans           &trans                &trans              &trans              &trans                &trans               &trans          &trans          &trans                &trans
            >;
        };

        FUNC {
            label = "L2 FUNCTION / LisM";
            bindings = <
                &kp F1           &kp F2                &kp F3              &kp F4               &kp F5             &kp F6              &kp F7         &kp F8          &kp F9                &kp F10
                &kp TAB          &kp LG(LS(LEFT_ARROW)) &kp LG(UP_ARROW)   &kp LG(LS(RIGHT_ARROW)) &trans          &trans              &kp LEFT_ARROW &kp UP_ARROW    &kp RIGHT_ARROW       &kp F11
                &kp LEFT_SHIFT   &trans                &kp LG(DOWN_ARROW)  &trans               &trans              &trans              &trans         &kp DOWN_ARROW  &trans                &trans
                &trans           &trans                &trans              &trans               &trans              &trans              &trans         &trans          &trans                &trans
            >;
        };

        MOUSE {
            label = "L3 AUTO MOUSE / LisM";
            // Keep KobitoKey's existing auto-layer activation/deactivation timing.
            bindings = <
                &trans           &trans                &trans              &trans               &trans              &trans              &trans         &msc MOVE_Y(10) &trans                &trans
                &kp A            &trans                &trans              &trans               &trans              &trans              &mkp MB1      &mkp MB3        &mkp MB2              &trans
                &trans           &trans                &trans              &trans               &trans              &trans              &trans         &msc MOVE_Y(-10) &trans               &trans
                &trans           &trans                &trans              &trans               &to 0               &trans              &trans         &trans          &to 0                 &trans
            >;
        };

        BT {
            label = "L4 BT";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &bt BT_PRV    &bt BT_NXT    &trans                        &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans                        &trans  &trans  &trans  &trans  &trans
&trans        &trans                      &trans        &trans        &trans  &trans  &trans  &trans          &trans  &trans
            >;
        };

        NUM2 {
            label = "L5 NUMBER2 (Compact5 trial)";
            bindings = <
&kp N1             &kp N2  &kp N3   &kp N4   &kp N5                           &kp N6     &kp N7  &kp N8  &kp N9  &kp KP_SLASH
&kp TAB            &trans  &trans   &trans   &kp LS(MINUS)                    &kp APOS   &kp N4  &kp N5  &kp N6  &kp KP_MULTIPLY
&kp LEFT_SHIFT     &trans  &trans   &trans   &kp INT3                         &kp COMMA  &kp N1  &kp N2  &kp N3  &kp KP_MINUS
&trans            &trans           &trans   &trans    &trans  &trans  &trans   &kp N0             &kp PERIOD &kp KP_PLUS
            >;
        };
    };
};
